# Conan host profile — Raspberry Pi 5 (aarch64 / armv8, GCC 11).
# Use with: --profile:host=profiles/rpi --profile:build=profiles/pc
[settings]
os=Linux
arch=armv8
compiler=gcc
compiler.version=11
compiler.libcxx=libstdc++11
compiler.cppstd=17
build_type=Release

[conf]
# Absolute paths prevent CMake's internal find_program() from accidentally
# picking up the ARM64 cross-compiler binaries inside the RPi sysroot.
tools.build:compiler_executables={"c": "/usr/bin/aarch64-linux-gnu-gcc", "cpp": "/usr/bin/aarch64-linux-gnu-g++", "strip": "/usr/bin/aarch64-linux-gnu-strip"}
